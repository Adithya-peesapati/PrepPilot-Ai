rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection - Allow read and write for profile sync
    match /users/{userId} {
      allow read, write: if true;
    }

    // Evaluations Collection - Allow read and write for evaluation reports
    match /evaluations/{reportId} {
      allow read, write: if true;
    }

    // Default deny rule for other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
